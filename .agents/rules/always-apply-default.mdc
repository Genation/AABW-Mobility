## 5. Processor Composition Pattern

The **processor pattern** is used when a complex pipeline has multiple,
independent stages that run in parallel or sequence. Each processor is a
function returned by a factory.

```typescript
// intenals/core/core.service.ts
export const createCoreService = () => {
  const queryProcessor = createQueryProcessor();
  const urlProcessor = createUrlProcessor();
  const semanticProcessor = createSemanticScoreProcessor();
  const articleProcessor = createArticleScoreProcessor();

  return {
    async processEval(url: string, query: string) {
      // Run independent stages in parallel
      const [queryResult, urlResult] = await Promise.all([
        queryProcessor.process(query),
        urlProcessor.process(url),
      ]);

      // Sequential post-processing
      const semanticScore = await semanticProcessor.process(
        queryResult.hyposEmbeddings,
        urlResult.chunkEmbeddings,
      );

      const articleScore = await articleProcessor.process(urlResult.content);

      return computeOverallScore(semanticScore, articleScore);
    },
  };
};

// intenals/core/processor/query.processor.ts
export const createQueryProcessor = () => {
  const llmService = createLLMService();
  const embeddingService = createEmbeddingService();

  return {
    async process(query: string): Promise<QueryProcessResult> {
      const expandedQueries = await llmService.expandQuery(query);
      const hypotheses = await llmService.generateHypo(expandedQueries);
      const embeddings = await embeddingService.calcEmbedding(hypotheses);
      return { expandedQueries, hypotheses, embeddings };
    },
  };
};
```

**Rule**: Each processor file should be **self-contained** — import its own
dependencies. Do not pass service instances between processors; each processor
creates its own.

