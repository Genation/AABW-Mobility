## 8. Queue-Based Async Processing

BullMQ is used for all **long-running background jobs**.

### Queue Definition

```typescript
// libs/queue/bullmq.ts
export const createQueue = () => {
  const redis = getRedisClient();
  return new Queue<EvaluateJobData>(QUEUE_NAMES.WORKER_EVALUATE, {
    connection: redis,
  });
};

// libs/queue/redis.ts
let _redis: Redis | undefined;
export const getRedisClient = () => {
  if (!_redis) {
    _redis = new Redis(env.REDIS_URL);
  }
  return _redis;
};

let _workerRedis: Redis | undefined;
export const createWorkerRedisClient = () => {
  if (!_workerRedis) {
    _workerRedis = new Redis(env.REDIS_URL);
  }
  return _workerRedis;
};
```

### Worker Configuration

```typescript
// Worker settings tuned for Jina API rate limits (~20 req/min)
export const WORKER_CONFIG = {
  concurrency: 8,
  limiter: { max: 20, duration: 60_000 }, // 20 jobs/minute
  lockDuration: 120_000, // 2-minute lock (covers ~90s max processing)
  maxStalledCount: 2,
};
```

### Job Processing Pattern

```typescript
// src/main-worker.ts
export const processEvaluateJob = async (job: Job<EvaluateJobData>) => {
  const { evaluationId, url, query } = job.data;
  const core = createCoreService();

  try {
    // Mark as in-progress
    await evaluationRepo.updateStatus(
      evaluationId,
      EvaluationStatus.PROCESSING,
    );

    // Run the full evaluation pipeline
    const result = await core.processEval(url, query);

    // Write results back
    await evaluationRepo.updateScores(evaluationId, {
      semanticScore: result.semanticScore,
      articleScore: result.articleScore,
      overallScore: result.overallScore,
      semanticAllChunks: result.chunkScores,
      semanticQueryMatrix: result.matrix,
      contentHash: result.hash,
      contentWordCount: result.wordCount,
      hyposEmbeddings: result.hyposEmbeddings,
    });

    await evaluationRepo.updateStatus(evaluationId, EvaluationStatus.COMPLETED);
  } catch (err) {
    await evaluationRepo.updateStatus(evaluationId, EvaluationStatus.FAILED);
    throw err; // Re-throw so BullMQ marks the job as failed
  }
};
```

